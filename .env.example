# Copy this file to .env.local and fill in values for local development.
# Production values live in Vercel dashboard, not here.

# LiveAvatar API key from app.liveavatar.com/developers
LIVEAVATAR_API_KEY=

# UUID of your trained custom avatar
AVATAR_ID=

# ElevenLabs Agent ID, format: agent_xxxxxxxxxx
ELEVENLABS_AGENT_ID=

# UUID returned by LiveAvatar /v1/secrets after registering ElevenLabs key
ELEVENLABS_SECRET_ID=

# CORS origin. Use * for local dev, set to https://talk.mikehyzy.com in prod
ALLOWED_ORIGIN=*
